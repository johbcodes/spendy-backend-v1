# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/spendy_db?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

MPESA_C2B_VALIDATION_URL=https://yourapi.com/api/mpesa/c2b/validate
MPESA_C2B_CONFIRMATION_URL=https://yourapi.com/api/mpesa/c2b/confirm
MPESA_B2C_RESULT_URL=https://yourapi.com/api/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://yourapi.com/api/mpesa/b2c/timeout
MPESA_INITIATOR_NAME=your_api_operator_username
MPESA_SECURITY_CREDENTIAL=<pre-encrypted password from Safaricom portal>

