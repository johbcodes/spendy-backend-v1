<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Welcome to Spendy</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .header { background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: #fff; padding: 32px; text-align: center; }
    .header h1 { margin: 0 0 8px; font-size: 28px; }
    .header p { margin: 0; opacity: .85; font-size: 15px; }
    .body { padding: 32px; color: #333; }
    .credentials { background: #f5f3ff; border: 1px solid #c4b5fd; border-radius: 8px; padding: 20px; margin: 20px 0; }
    .credentials p { margin: 6px 0; font-size: 14px; }
    .credentials strong { color: #6d28d9; }
    .warning { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 12px 16px; margin: 20px 0; font-size: 13px; color: #92400e; }
    .footer { text-align: center; padding: 20px 32px; font-size: 12px; color: #9ca3af; border-top: 1px solid #e5e7eb; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Welcome to Spendy</h1>
      <p>Your expense management account is ready</p>
    </div>
    <div class="body">
      <p>Hi {{firstName}},</p>
      <p>Your account has been created by {{createdByName}}. Here are your login credentials:</p>
      <div class="credentials">
        <p><strong>Email:</strong> {{email}}</p>
        <p><strong>Temporary Password:</strong> {{password}}</p>
        <p><strong>Role:</strong> {{role}}</p>
      </div>
      <div class="warning">
        Please change your password immediately after your first login for security.
      </div>
      <p>You can log in at: <strong>{{loginUrl}}</strong></p>
    </div>
    <div class="footer">Spendy &mdash; Smart Expense Management</div>
  </div>
</body>
</html>
