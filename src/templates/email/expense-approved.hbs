<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Expense Approved</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .header { background: #3b82f6; color: #fff; padding: 24px 32px; }
    .header h1 { margin: 0; font-size: 22px; }
    .badge { display: inline-block; background: #dcfce7; color: #16a34a; font-weight: bold; padding: 6px 14px; border-radius: 20px; font-size: 13px; margin-bottom: 16px; }
    .body { padding: 32px; color: #333; }
    .amount-box { background: #eff6ff; border: 1px solid #93c5fd; border-radius: 8px; padding: 20px; text-align: center; margin: 24px 0; }
    .amount-box .amount { font-size: 32px; font-weight: bold; color: #2563eb; margin: 8px 0; }
    .meta { background: #f9fafb; border-radius: 6px; padding: 16px; margin-top: 20px; }
    .meta p { margin: 6px 0; font-size: 14px; color: #6b7280; }
    .meta strong { color: #111827; }
    .footer { text-align: center; padding: 20px 32px; font-size: 12px; color: #9ca3af; border-top: 1px solid #e5e7eb; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header"><h1>Expense Approved</h1></div>
    <div class="body">
      <span class="badge">Approved</span>
      <p>Hi {{firstName}},</p>
      <p>Your expense request has been approved. The funds have been transferred to your personal wallet.</p>
      <div class="amount-box">
        <div style="font-size:13px;color:#6b7280;text-transform:uppercase;letter-spacing:1px;">Approved Amount</div>
        <div class="amount">KES {{approvedAmount}}</div>
      </div>
      <div class="meta">
        <p><strong>Expense:</strong> {{expenseTitle}}</p>
        <p><strong>Approved By:</strong> {{approverName}}</p>
        {{#if notes}}<p><strong>Notes:</strong> {{notes}}</p>{{/if}}
        <p><strong>Date:</strong> {{date}}</p>
      </div>
    </div>
    <div class="footer">Spendy &mdash; Smart Expense Management</div>
  </div>
</body>
</html>
