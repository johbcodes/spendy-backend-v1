<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Expense Rejected</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
    .header { background: #ef4444; color: #fff; padding: 24px 32px; }
    .header h1 { margin: 0; font-size: 22px; }
    .badge { display: inline-block; background: #fee2e2; color: #dc2626; font-weight: bold; padding: 6px 14px; border-radius: 20px; font-size: 13px; margin-bottom: 16px; }
    .body { padding: 32px; color: #333; }
    .meta { background: #f9fafb; border-radius: 6px; padding: 16px; margin-top: 20px; }
    .meta p { margin: 6px 0; font-size: 14px; color: #6b7280; }
    .meta strong { color: #111827; }
    .reason-box { background: #fef2f2; border-left: 4px solid #ef4444; padding: 14px 16px; margin: 20px 0; border-radius: 0 6px 6px 0; }
    .footer { text-align: center; padding: 20px 32px; font-size: 12px; color: #9ca3af; border-top: 1px solid #e5e7eb; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header"><h1>Expense Rejected</h1></div>
    <div class="body">
      <span class="badge">Rejected</span>
      <p>Hi {{firstName}},</p>
      <p>Unfortunately your expense request has been rejected.</p>
      {{#if reason}}
      <div class="reason-box">
        <strong>Reason:</strong> {{reason}}
      </div>
      {{/if}}
      <div class="meta">
        <p><strong>Expense:</strong> {{expenseTitle}}</p>
        <p><strong>Amount Requested:</strong> KES {{amount}}</p>
        <p><strong>Rejected By:</strong> {{approverName}}</p>
        <p><strong>Date:</strong> {{date}}</p>
      </div>
      <p style="margin-top:20px;font-size:13px;color:#6b7280;">
        You may edit and resubmit your expense. Contact your approver if you need clarification.
      </p>
    </div>
    <div class="footer">Spendy &mdash; Smart Expense Management</div>
  </div>
</body>
</html>
